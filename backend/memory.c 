#include <stdio.h>

void allocate(int b[], int m, int p[], int n, int type) {
    int a[20], used[20] = {0}, i, j, k;

    for (i = 0; i < n; i++) a[i] = -1;

    for (i = 0; i < n; i++) {
        k = -1;

        for (j = 0; j < m; j++) {
            if (!used[j] && b[j] >= p[i]) {
                if (type == 1) {
                    k = j;
                    break;
                }
                if (k == -1 ||
                    (type == 2 && b[j] < b[k]) ||
                    (type == 3 && b[j] > b[k]))
                    k = j;
            }
        }

        if (k != -1) {
            a[i] = k;
            used[k] = 1;
        }
    }

    printf("\n%s Fit:\n",
           type == 1 ? "First" :
           type == 2 ? "Best" : "Worst");

    for (i = 0; i < n; i++) {
        if (a[i] != -1)
            printf("Process %d (%d KB) -> Partition %d (%d KB)\n",
                   i + 1, p[i], a[i] + 1, b[a[i]]);
        else
            printf("Process %d (%d KB) -> Not Allocated\n",
                   i + 1, p[i]);
    }

    printf("Unallocated partitions: ");
    for (i = 0, j = 0; i < m; i++)
        if (!used[i]) {
            printf("%d ", i + 1);
            j++;
        }

    if (!j) printf("None");
    printf("\n");
}

int main() {
    int b[20], p[20], m, n, i;

    printf("Enter number of partitions: ");
    scanf("%d", &m);

    printf("Enter partition sizes: ");
    for (i = 0; i < m; i++) scanf("%d", &b[i]);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter process sizes: ");
    for (i = 0; i < n; i++) scanf("%d", &p[i]);

    allocate(b, m, p, n, 1);
    allocate(b, m, p, n, 2);
    allocate(b, m, p, n, 3);

    return 0;
}
